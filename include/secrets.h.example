// Template for local credentials.
//
// Copy this file to secrets.h and fill in your own network details.
// secrets.h is listed in .gitignore and must never be committed.
#pragma once

#define WIFI_SSID "your-ssid-here"
#define WIFI_PASS "your-password-here"

// ---------------------------------------------------------------------------
// M7 cloud relay (public access). The device dials OUT to this server, so the
// home network keeps zero open ports (PROJECT_PLAN.md 5.3).
// ---------------------------------------------------------------------------
// Relay server host, e.g. your Aliyun ECS domain or IP.
#define RELAY_HOST "your-relay.example.com"
// TLS port the relay listens on (the plan suggests 9000 behind TLS termination).
#define RELAY_PORT 9000
// Pre-shared device token; the relay rejects hello frames with other tokens.
#define RELAY_TOKEN "change-me-to-a-long-random-string"
// CA certificate (PEM) of the relay's TLS certificate, used for pinning.
// Leave empty ONLY together with -DRELAY_INSECURE_SKIP_CERT_VERIFY (dev).
#define RELAY_CA_CERT ""

